# Copy to ~/.lark-channel/profiles/<profile>/runtime.env and chmod 600.
# Literal values only: no $HOME expansion, shell commands or export required.
# Delete unused entries. Do not commit your real runtime.env or credentials.

# CODEX_HOME='/absolute/path/to/.codex'
# CODEX_QUEUE_REMOTE='unix:///absolute/path/to/app-server-control.sock'
# LARK_CHANNEL_CODEX_BIN='/absolute/path/to/codex'
# CLAUDE_CONFIG_DIR='/absolute/path/to/.claude'
# LARK_CHANNEL_CLAUDE_BIN='/absolute/path/to/claude'
# PATH='/absolute/path/to/tools/bin:/usr/local/bin:/usr/bin:/bin'

# Agent provider/proxy settings, only if required by your own environment.
# HTTPS_PROXY='http://127.0.0.1:7890'
# HTTP_PROXY='http://127.0.0.1:7890'
# NO_PROXY='localhost,127.0.0.1'
# ANTHROPIC_BASE_URL='https://your-provider.example'
# ANTHROPIC_API_KEY='set-locally-only'
# OPENAI_API_KEY='set-locally-only'

# Feishu defaults to direct networking. Explicitly opt in if your network
# requires HTTP/WebSocket proxying; HTTPS_PROXY alone does not enable it.
# LARK_CHANNEL_FEISHU_USE_PROXY='1'
